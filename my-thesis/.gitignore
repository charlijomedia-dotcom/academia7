# Derived, regenerable, or non-thesis-facing artifacts.
#
# Deliberately NOT ignored:
#   data/frozen/   the immutable thesis snapshot and its manifest (decision D13)
#   output/        thesis-facing results, which must be traceable from the repository

# Fit caches and checkpoints (regenerable; keyed by data, code and config hashes)
cache/
smoke_cache/
cache_refreshed/

# Non-baseline output namespaces (never thesis-facing, decision D16)
smoke_output/
output_refreshed/

# Operational run logs: console log, structured progress events and progress snapshot.
# Timestamps and heartbeats only; every thesis-facing result is under output/.
run_logs/

# Refreshed and audit data snapshots (never the thesis baseline)
data/refreshed/
data/audit/

# Local Python virtual environments. A virtual environment is not an input to the
# analysis: its contents are fully determined by code/requirements.lock.txt, whose hash is
# recorded in every run manifest. Excluding it keeps the documented setup in REPRODUCING.md
# (`python -m venv .venv` inside my-thesis/) from making the working tree dirty and so
# blocking a legitimate baseline run.
.venv/
venv/
ENV/
env/

# Environment files may hold credentials such as a FRED API key, which must never reach
# the repository (Part 5 computational spec section 2).
.env
.env.*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
